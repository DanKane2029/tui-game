    (name: "Gust",  mana_cost: 1, element: Gust,  power: 2),
    (name: "Frost", mana_cost: 2, element: Ice,   power: 4),
    (name: "Surge", mana_cost: 3, element: Shock, power: 5),
    (name: "Spore", mana_cost: 2, element: Toxic, power: 3),
    (name: "Shard", mana_cost: 2, element: Earth, power: 4),
]
